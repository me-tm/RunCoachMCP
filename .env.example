# ── COROS Open API (optional) ─────────────────────────────────────────────────
# Get these from https://open.coros.com
# Set redirect URI to: http://localhost:8080/auth/coros/callback
COROS_CLIENT_ID=your_coros_client_id_here
COROS_CLIENT_SECRET=your_coros_client_secret_here

# ── Encryption key ────────────────────────────────────────────────────────────
# Encrypts tokens stored at ~/.claude2strava/ (garmin_session.enc, coros_tokens.enc)
# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your_fernet_key_here

# ── Web session signing key ───────────────────────────────────────────────────
# Signs the OAuth state cookie to prevent CSRF
# Generate once with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEB_SECRET_KEY=your_random_hex_string_here

# ── Optional overrides ────────────────────────────────────────────────────────
# Web UI port (default: 8080)
# WEB_PORT=8080

# Token storage directory (default: ~/.claude2strava)
# TOKEN_DIR=/home/you/.claude2strava
